# Cấu hình KHÔNG bí mật cho Daily News (được bash `source`).
# Secrets (GCHAT_WEBHOOK_URL, API keys) KHÔNG đặt ở đây — xem README.

NEWS_TZ="Asia/Ho_Chi_Minh"
PAGES_BASE_URL="https://sontvwork.github.io/daily-news"

# Cửa sổ research (ngày). 1 = ~24 giờ gần nhất.
LOOKBACK_DAYS=1

# Số ngày giữ bản tin trên main + site, tính lùi từ DATE của bản tin (kể cả DATE).
# publish.sh (news.py prune) xoá .md/raw/briefs cũ hơn; guard.sh chỉ cho xoá đúng các file đó.
# Hằng số (không `${…:-}`) vì news.py cũng tự đọc file này.
RETENTION_DAYS=30

# Bỏ nguồn paper học thuật (arxiv), GitHub và X:
# - GitHub: proxy của cloud sandbox chỉ cho gọi repos/{owner}/{repo}/... của repo gắn với session,
#   nên /search/issues luôn 403 (token nào cũng vậy).
# - X: trên cloud chỉ bật được bằng key trả phí (XAI_API_KEY = Grok x_search, hoặc XQUIK_API_KEY); không dùng.
# Local muốn bật lại: EXCLUDE_SOURCES=arxiv bash scripts/research.sh ...
EXCLUDE_SOURCES="${EXCLUDE_SOURCES:-arxiv,github,x}"

# Mỗi phần tử: "<slug>|<domain cho --discover>".
# Gate của engine = OR các token trong domain (bỏ từ chung như ai/tech/trending).
DOMAINS=(
  "coding-assistants|AI coding assistants Claude Code Cursor GitHub Copilot Antigravity"
  "agents-sdlc|AI agents software development testing code review DevOps CI/CD"
  "models-infra|new LLM models open-weight MCP inference agentic coding vibe coding Claude GPT Gemini Qwen DeepSeek Kimi"
)
